        <mxCell id="c2" value="&lt;b&gt;Vessel knowledge graph — extraction pipeline (docs/08)&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#666&#x27;&gt;Casefile export → per-casefile record + attachment digests. Blue = deterministic, orange = model call, green = validation.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="50" as="geometry"/></mxCell>
<mxCell id="c3" value="&lt;b&gt;Casefile export&lt;/b&gt; (source Mongo, read-only)&lt;br&gt;_id · imo · casefile · category · UICategory · tag&lt;br&gt;pages[] {referenceId, pagenum, dateTime, link[0], attachments[]}" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=8;size=0.15;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="420" height="80" as="geometry"/></mxCell>
<mxCell id="c4" value="&lt;b&gt;① HEADER&lt;/b&gt; — no model&lt;br&gt;record := {casefile_id, imo, problem_statement = export.casefile (verbatim), export_meta {category, UICategory, tags}, progress {-1,false}, equipment[], problems[], faults[], action_logs[]}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="420" height="90" as="geometry"/></mxCell>
