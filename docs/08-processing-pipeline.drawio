<mxCell id="c14" value="&lt;b&gt;hit&lt;/b&gt; → append {mailbodyId, casefileId, url, name} to links[] if new" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="c6"><mxGeometry x="380" y="250" width="300" height="60" as="geometry"/></mxCell>
