<mxCell id="c29" value="insert with text" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=1.5;" edge="1" parent="c6" source="c24" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c30" value="lookup" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=1.5;dashed=1;" edge="1" parent="c6" source="c26" target="c12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="870" y="280"/><mxPoint x="870" y="280"/></Array></mxGeometry></mxCell>
<mxCell id="c31" value="&lt;b&gt;c. LLM_update(record, 6 bodies, digests of their content-bearing files)&lt;/b&gt;&lt;br&gt;may ADD equipment e* · problems p* · faults f* · actions a*&lt;br&gt;may UPDATE an action&#x27;s outcome / dates / parts / target, a fault&#x27;s problem_id&lt;br&gt;may NOT remove or renumber → code asserts (dropped_object)&lt;br&gt;every row: mail_ids [+ attachment_shas] + evidence_quote · unknown is a value" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="c6"><mxGeometry x="720" y="560" width="300" height="150" as="geometry"/></mxCell>
<mxCell id="c32" value="digests" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=1.5;" edge="1" parent="c6" source="c26" target="c31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c33" value="bodies" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="c6" source="c8" target="c31"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="870" y="85"/></Array></mxGeometry></mxCell>
<mxCell id="c34" value="&lt;b&gt;d. progress.last_pagenum_processed := window&#x27;s last pagenum&lt;/b&gt; (checkpoint; resumable)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="c6"><mxGeometry x="20" y="720" width="700" height="40" as="geometry"/></mxCell>
<mxCell id="c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=1.5;" edge="1" parent="c6" source="c31" target="c34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c36" value="next window" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=1.5;dashed=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="c6" source="c34" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="8" y="740"/><mxPoint x="8" y="85"/></Array></mxGeometry></mxCell>
<mxCell id="c37" value="&lt;b&gt;③ CONSOLIDATE&lt;/b&gt; — one model call over the record only&lt;br&gt;merge duplicate actions · seq by date_performed else date_reported · occurrence_no" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="1160" width="420" height="70" as="geometry"/></mxCell>
<mxCell id="c38" value="after last page" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=1.5;exitX=0.2;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c6" target="c37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c39" value="&lt;b&gt;④ VALIDATE&lt;/b&gt; — no model&lt;br&gt;schema · e/p/f ids resolve · every cited sha exists with a link on a cited mail · every evidence_quote found verbatim in the cited mail body / document text · outcome ≠ unknown ⇒ outcome_in_mail + quote · cap ~25 actions&lt;br&gt;→ validation_flags[], needs_review — the record loads either way" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="1270" width="620" height="110" as="geometry"/></mxCell>
<mxCell id="c40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=1.5;" edge="1" parent="1" source="c37" target="c39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c41" value="&lt;b&gt;vessel_issues_incident_reports&lt;/b&gt;&lt;br&gt;the record — one doc per casefile&lt;br&gt;(schema/casefile_extract.v2.schema.json)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1430" width="300" height="90" as="geometry"/></mxCell>
<mxCell id="c42" value="⑤ store" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=1.5;" edge="1" parent="1" source="c39" target="c41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c43" value="&lt;b&gt;vessel_issues_mail_attachments&lt;/b&gt;&lt;br&gt;(written during ②; schema/attachment_digest.v1.schema.json)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="1430" width="300" height="90" as="geometry"/></mxCell>
<mxCell id="c44" value="&lt;b&gt;mail_bodies&lt;/b&gt; cache&lt;br&gt;(written during ②)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="1430" width="220" height="90" as="geometry"/></mxCell>
<mxCell id="c45" value="&lt;b&gt;⑥ LOAD / RESOLVE&lt;/b&gt; — Part 3, not built yet&lt;br&gt;flat faults + action_log projections · action_canonical / symptom / equipment canonical via the resolver · casefile_id-prefixed global ids · cross-casefile thread merge · graph" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#666666;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="1560" width="620" height="90" as="geometry"/></mxCell>
<mxCell id="c46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="c41" target="c45"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=1.5;dashed=1;entryX=0.7;entryY=0;" edge="1" parent="1" source="c43" target="c45"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c48" value="&lt;b&gt;Join contract&lt;/b&gt; (07 §3)&lt;br&gt;record …provenance.attachment_shas[i] == attachments.sha256&lt;br&gt;record …provenance.mail_ids ∩ attachments.links[].mailbodyId ≠ ∅&lt;br&gt;A cited sha with content_bearing=false is a validation flag." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1120" y="340" width="360" height="110" as="geometry"/></mxCell>
<mxCell id="c49" value="&lt;b&gt;What the model is asked, and nothing else&lt;/b&gt;&lt;br&gt;per window: new e/p/f/a rows with ids + quotes; outcome updates a mail states&lt;br&gt;per new file: one digest&lt;br&gt;never: casefile summaries, mail titles, counts, durations, canonical names, inferred outcomes (05 §5)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1120" y="470" width="360" height="130" as="geometry"/></mxCell>
<mxCell id="c50" value="&lt;b&gt;Re-run rule&lt;/b&gt;&lt;br&gt;source updatedAt moves → rebuild from ① ; the attachment collection and mail cache make it cheap.&lt;br&gt;&lt;br&gt;&lt;b&gt;Open&lt;/b&gt;: assets-prod.siya.com reachability from the processing environment (02 §8.5, 04 §5)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1120" y="620" width="360" height="120" as="geometry"/></mxCell>
<mxCell id="c51" value="&lt;b&gt;KING ONE&lt;/b&gt; (69a6965bf935cb9be885b8ee)&lt;br&gt;218 pages → 44 windows&lt;br&gt;166 links → 53 files → 45 content-bearing&lt;br&gt;→ 2 equipment · 1 problem · 4 faults · 10 actions&lt;br&gt;outcomes: 3 resolved/conclusive · 2 partial · 5 unknown · 0 validation flags" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1120" y="760" width="360" height="120" as="geometry"/></mxCell>
