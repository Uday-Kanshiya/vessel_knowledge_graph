<mxCell id="c6" value="② WINDOW LOOP — pages sorted by pagenum · window 6 · stride 5 (one-mail overlap) · repeat to last page" style="swimlane;whiteSpace=wrap;html=1;startSize=28;fillColor=#f8f8f8;strokeColor=#999999;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="1040" height="780" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;b&gt;a. fetch mail bodies&lt;/b&gt;&lt;br&gt;pages[].link[0] → HTML → text (quoted replies stripped)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="c6"><mxGeometry x="20" y="50" width="300" height="70" as="geometry"/></mxCell>
