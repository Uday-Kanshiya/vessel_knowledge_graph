<mxCell id="c26" value="&lt;b&gt;vessel_issues_mail_attachments&lt;/b&gt;&lt;br&gt;one doc per sha256 · links[] · content_bearing · digest · extracted_text | text_ref · extraction_method" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="c6"><mxGeometry x="720" y="400" width="300" height="110" as="geometry"/></mxCell>
