# =============================================================================
# Vessel Knowledge Graph — environment template
# Copy to `.env` (gitignored) and fill in. Every var is read in src/config.
# =============================================================================

APP_ENV=dev
LOG_LEVEL=INFO

# =============================================================================
# LLM
# =============================================================================
LLM_PROVIDER=openai             # openai | azure
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_openai_api_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.1             # ignored by reasoning models (gpt-5, o-series)

# --- Azure (when LLM_PROVIDER=azure) ---
# LLM_AZURE_ENDPOINT=https://your-resource.cognitiveservices.azure.com
# LLM_AZURE_API_VERSION=2025-04-01-preview

# =============================================================================
# Langfuse — OPTIONAL. Off unless ENABLED=true AND all three below are set AND
# the extra is installed (`uv sync --extra observability`).
# =============================================================================
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://langfuse.siya.com

# =============================================================================
# Extraction run (docs/10-extraction-run-guide.md). All optional; defaults shown.
# =============================================================================
# Path to casefiles_export_*.json (never committed); --export overrides. Keep this line comment-free.
CASEFILE_EXPORT_PATH=
EXTRACTION_DATA_DIR=data         # run store: mail cache, attachment digests, records (gitignored)
RESOLUTION_DB_PATH=              # alias table (SQLite); empty = <EXTRACTION_DATA_DIR>/resolution/lookup.sqlite
RESOLUTION_SEED_CSV=             # human-edited seed; empty = src/resolution/seed_aliases.csv
RESOLUTION_CONFIG_DIR=           # modifier_terms.csv + vessel_names.txt; empty = config/
SYMPTOM_LINKS_PATH=              # reviewed broader_than symptom links for the site; empty = config/symptom_links.json
SYMPTOM_FAMILIES_CSV=            # bounded symptom family list; empty = config/symptom_families.csv
SEED_SYMPTOM_ALIASES_CSV=        # reviewed symptom aliases + families; empty = config/seed_symptom_aliases.csv
EXTRACTION_WINDOW_SIZE=5         # mails per model call — the hard cap
EXTRACTION_WINDOW_OVERLAP=0      # 0 = every window is 5 new mails; context comes from the id-keyed record summary
EXTRACTION_MAIL_MAX_CHARS=12000  # body text per mail handed to the model; cut is marked
EXTRACTION_STRIP_QUOTES=true     # cut quoted earlier mails at explicit separators
EXTRACTION_MAX_ACTIONS=25        # over this: over_cap flag + needs_review, nothing truncated
CONSOLIDATE_MERGE_MAX_DAYS=3     # duplicate merges refused when the two mails are further apart (or dates differ); -1 = off
CONSOLIDATE_FAULT_PAIR_MIN_SIM=0.6  # look-alike fault pairs above this similarity are judged at consolidate
EXTRACTION_WINDOW_MAX_TOKENS=16384     # output budget per window/consolidate call (reasoning tokens count)
EXTRACTION_WINDOW_MAX_TOKENS_CAP=65536 # doubled on finish_reason=length up to this
EXTRACTION_LLM_RETRIES=3         # retries on rate limit / timeout / 5xx
EXTRACTION_LLM_RETRY_BASE_SECONDS=2.0
EXTRACTION_ATTACHMENT_MODE=digest    # off | list | digest
EXTRACTION_ATTACHMENT_CONCURRENCY=4
EXTRACTION_DIGEST_TEXT_MAX_CHARS=20000
EXTRACTION_VISION_ENABLED=false  # true => one vision call per content-bearing image (most expensive route)
ATTACHMENT_JUNK_MAX_BYTES=15360  # images under this are signature/inline junk
ATTACHMENT_JUNK_MAX_PIXELS=200   # images under this on either side are junk
ATTACHMENT_INLINE_NAME_MAX_BYTES=102400  # image0NN.png etc. above this size is a pasted photo, kept
PDF_OCR_PAGE_THRESHOLD=200       # chars per page below which a PDF page counts as scanned
PDF_OCR_BACKEND=vision           # off | vision (chat model transcribes rendered pages) | tesseract
PDF_OCR_MAX_PAGES=10             # scanned pages transcribed per file; the rest is noted
PDF_OCR_DPI=150
EXTRACTION_OCR_MODEL=            # vision-capable model for OCR; empty = LLM_MODEL
EXTRACTION_TRANSLATE_QUOTES=true # non-English quotes stored as "original [EN: translation]"
EXTRACTION_SPLIT_SHARED_QUOTES=true  # cut a sentence that evidences both an action and its result into two quotes
FETCH_TIMEOUT_SECONDS=30
FETCH_RETRIES=3
FETCH_MAX_BYTES=41943040
WINDOW_UPDATE_PROMPT_VERSION=v7  # src/prompts/window_update/<v>.md (v7 = controlled failure verbs, when / how often in position; v6 = symptom ≤6 words; v5 = one event one row)
CONSOLIDATE_PROMPT_VERSION=v4    # v4 names the controlled verbs; v3 the short-symptom note; v2 judges look-alike fault pairs
ATTACHMENT_DIGEST_PROMPT_VERSION=v1
OCR_TRANSCRIBE_PROMPT_VERSION=v1
TRANSLATE_QUOTES_PROMPT_VERSION=v1
SPLIT_QUOTE_PROMPT_VERSION=v1
